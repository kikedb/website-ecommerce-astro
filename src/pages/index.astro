---
import Layout from '@/layouts/Layout.astro';
import { fetchProducts, getImageUrl } from '@/lib/api';

const productsResponse = await fetchProducts({ per_page: 8 });
// Some endpoints return data in { data: [...] }, some return [...] directly
const products = Array.isArray(productsResponse) ? productsResponse : (productsResponse?.data || []);
---

<Layout>
	<section class="container mx-auto px-4 py-20 text-center">
		<h1 class="text-5xl md:text-7xl font-black text-bilbola-text-primary mb-6 font-bilbola">
			Descubre un mundo de <span class="text-bilbola-mint-depth">magia</span> y <span class="text-bilbola-mint-depth">alegría</span>
		</h1>
		<p class="text-xl md:text-2xl text-bilbola-text-primary/80 max-w-3xl mx-auto mb-10 leading-relaxed font-light">
			En cada rincón, encontrarás una conexión profunda con el niño interior, donde los sueños se hacen realidad y la imaginación vuela sin límites.
		</p>
	</section>

	<section class="bg-bilbola-mint-light/30 py-16">
		<div class="container mx-auto px-4">
			<h2 class="text-3xl font-black text-bilbola-text-primary mb-10 text-center font-bilbola">Novedades y Favoritos</h2>
			
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
				{products.map((product) => (
					<a href={`/productos/${product.id}`} class="group bg-white rounded-bilbola-md shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-bilbola-mint-light">
						<div class="aspect-square relative overflow-hidden bg-bilbola-gray-light/10 p-6 flex items-center justify-center">
							<img 
								src={getImageUrl(product.image || product.featured_image)} 
								alt={product.name} 
								class="object-contain w-full h-full group-hover:scale-110 transition-transform duration-500"
							/>
						</div>
						<div class="p-6">
							<h3 class="font-bold text-lg text-bilbola-text-primary mb-2 truncate font-bilbola" title={product.name}>{product.name}</h3>
							<p class="text-bilbola-mint-depth font-black text-xl font-bilbola">${product.price?.toLocaleString('es-CL')}</p>
						</div>
					</a>
				))}
			</div>

			{products.length === 0 && (
				<p class="text-center text-bilbola-text-secondary py-10 font-bilbola">No hay productos disponibles por el momento.</p>
			)}
		</div>
	</section>
</Layout>
