---
import Layout from '@/layouts/Layout.astro';
import { fetchProducts, getImageUrl } from '@/lib/api';
import HeroSlider from '@/components/ecommerce/HeroSlider.vue';
import CategoryGrid from '@/components/ecommerce/CategoryGrid.astro';
import ProductCard from '@/components/ecommerce/ProductCard.vue';
import CtaBanner from '@/components/ecommerce/CtaBanner.astro';
import TestimonialSlider from '@/components/ecommerce/TestimonialSlider.vue';
import PartnersGrid from '@/components/ecommerce/PartnersGrid.astro';

const productsResponse = await fetchProducts({ per_page: 8 });
const fetchedProducts = Array.isArray(productsResponse) ? productsResponse : (productsResponse?.data || []);

// Respaldo visual si el backend no retorna suficientes productos aún para mostrar las 8 unidades solicitadas
const products = fetchedProducts.length >= 4 ? fetchedProducts : [
  {
    id: 101,
    name: 'Cama Montessori Roble Natura - Plaza y Media',
    price: 189990,
    originalPrice: 219990,
    image: 'https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: true,
    badges: [{ type: 'customizable', label: 'Madera Roble' }]
  },
  {
    id: 102,
    name: 'Lámpara de Noche Nube Mágica (LED Cálido)',
    price: 34990,
    image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: false,
    badges: [{ type: 'bestseller', label: 'Más Vendido' }]
  },
  {
    id: 103,
    name: 'Set Textil Algodón Orgánico 300 Hilos - Safari',
    price: 49990,
    originalPrice: 59990,
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: false,
    badges: [{ type: 'eco', label: '100% Orgánico' }]
  },
  {
    id: 104,
    name: 'Estante Librero Frontal Oso Polar - Blanco Mate',
    price: 64990,
    image: 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: true
  },
  {
    id: 105,
    name: 'Móvil Colgante Estrellas & Lunas Tejiendo Sueños',
    price: 28990,
    image: 'https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: false,
    badges: [{ type: 'new', label: 'Nuevo' }]
  },
  {
    id: 106,
    name: 'Alfombra de Juegos Acolchada Hipoalergénica',
    price: 42990,
    originalPrice: 52990,
    image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: false
  },
  {
    id: 107,
    name: 'Baúl Organizador Juguetero sobre Ruedas',
    price: 55990,
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80',
    inStock: false,
    isCustomizable: false
  },
  {
    id: 108,
    name: 'Espejo Montessori Seguro Irrompible con Barra',
    price: 79990,
    image: 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=600&q=80',
    inStock: true,
    isCustomizable: true,
    badges: [{ type: 'customizable', label: 'A Medida' }]
  }
];
---

<Layout>
  {/* 1. Hero de Slider con Swiper y Vue */}
  <HeroSlider client:load />

  {/* 2. Categorías de productos */}
  <CategoryGrid />

  {/* 3. 8 Productos Destacados reusando el componente ProductCard de Vue */}
  <section class="py-20 bg-gradient-to-b from-bilbola-surface-page to-white font-bilbola">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="px-3 py-1 bg-bilbola-mint-light/60 text-bilbola-action-focus rounded-full text-xs font-bold tracking-widest uppercase inline-block shadow-2xs">
          Selección Exclusiva ⭐
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-bilbola-text-primary tracking-tight font-serif">
          Productos Destacados
        </h2>
        <p class="text-bilbola-text-secondary text-base md:text-lg font-light">
          Piezas con diseño de vanguardia, seguras, artesanales y pensadas para despertar la imaginación infantil en cada espacio.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {products.slice(0, 8).map((product: any) => (
          <ProductCard
            client:visible
            id={product.id}
            name={product.name}
            price={product.price || 0}
            originalPrice={product.originalPrice || product.original_price}
            imageUrl={product.image && product.image.startsWith('http') ? product.image : getImageUrl(product.image || product.featured_image)}
            inStock={product.inStock !== false && product.in_stock !== false}
            isCustomizable={product.isCustomizable || product.is_customizable}
            badges={product.badges || []}
            productUrl={`/productos/${product.id}`}
            ctaLabel="Ver detalles"
          />
        ))}
      </div>

      {products.length === 0 && (
        <p class="text-center text-bilbola-text-secondary py-10 font-light">No hay productos disponibles en este momento.</p>
      )}
    </div>
  </section>

  {/* 4. CTA para ir al Catálogo */}
  <CtaBanner
    title="¿Quieres descubrir todos nuestros productos?"
    subtitle="Explora el catálogo completo con más de 100 alternativas personalizables para el dormitorio de tus hijos, con envío asegurado a todo Chile."
    buttonText="Ver Catálogo Completo"
    buttonUrl="/productos"
    variant="mint"
    icon="🛍️"
    badge="Catálogo 2026"
  />

  {/* 5. Slider con Testimonios (Vue + Swiper) */}
  <TestimonialSlider client:visible />

  {/* 6. Info con nuestros partners y sus 8 logos (placeholders) */}
  <PartnersGrid />

  {/* 7. CTA al Quiénes Somos */}
  <CtaBanner
    title="Conoce la historia detrás de Bílbola"
    subtitle="Somos un taller familiar apasionado por la infancia libre, segura y respetada. Descubre nuestra filosofía de diseño y sustentabilidad."
    buttonText="Conócenos AQUÍ"
    buttonUrl="/nosotros"
    variant="dark"
    icon="🌿"
    badge="Filosofía Bílbola"
  />

  {/* 8. El Footer se encuentra incluido automáticamente al finalizar la etiqueta Layout */}
</Layout>
