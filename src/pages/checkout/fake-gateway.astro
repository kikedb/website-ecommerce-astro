---
import CheckoutLayout from '@/layouts/CheckoutLayout.astro';
---

<CheckoutLayout title="Simulador de Pasarela de Pagos | QA Bílbola">
    <div class="max-w-2xl mx-auto w-full py-8 px-4 font-bilbola animate-fadeIn">
        
        <!-- Tarjeta del Simulador Bancario -->
        <div class="bg-white rounded-bilbola-lg border-2 border-bilbola-gray-light/40 shadow-xl overflow-hidden">
            
            <!-- Cabecera de Pasarela Agnóstica -->
            <div class="bg-slate-900 text-white p-6 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-500/20 border border-blue-400 flex items-center justify-center font-black text-lg">
                        P
                    </div>
                    <div>
                        <span class="text-sm font-black tracking-widest uppercase block text-blue-400">Pasarela de Pagos Seguro</span>
                        <span class="text-xs text-slate-300">Conexión Bancaria &amp; Procesamiento Encriptado</span>
                    </div>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-amber-500/20 border border-amber-400 text-amber-300 text-[10px] font-black uppercase tracking-wider animate-pulse">
                    🚧 Entorno DEV / QA
                </span>
            </div>

            <div class="p-6 sm:p-8 space-y-7">
                
                <!-- Información transaccional -->
                <div class="bg-slate-50 p-5 rounded-bilbola-md border border-slate-200/80 space-y-3">
                    <h3 class="text-xs font-black uppercase text-slate-700 tracking-wide flex items-center gap-2">
                        <span>Detalle de la Orden Electrónica Bílbola:</span>
                    </h3>

                    <div class="grid grid-cols-2 gap-4 text-sm pt-2 border-t border-slate-200">
                        <div>
                            <span class="text-xs text-slate-500 block">Número de Orden:</span>
                            <span id="display-order-id" class="font-black text-slate-900 text-base">BIL-XXXXXX</span>
                        </div>
                        <div class="text-right">
                            <span class="text-xs text-slate-500 block">Monto a Autorizar:</span>
                            <span id="display-amount" class="font-black text-emerald-600 text-xl">$XX.XXX CLP</span>
                        </div>
                    </div>

                    <div class="pt-2 flex items-center justify-between text-xs text-slate-600 border-t border-slate-200/60 font-semibold">
                        <span>Comercio: <strong>Bílbola Deco Kids Spa</strong></span>
                        <span id="display-method" class="bg-white px-2 py-0.5 rounded-sm border border-slate-200 text-[11px] font-bold text-slate-700 uppercase">
                            Pago en Línea
                        </span>
                    </div>
                </div>

                <div class="text-center space-y-1">
                    <h2 class="text-base font-extrabold text-slate-800">
                        ¿Qué resultado deseas simular en este entorno de pruebas?
                    </h2>
                    <p class="text-xs text-slate-500 leading-relaxed max-w-md mx-auto">
                        Al hacer clic en cualquiera de estas opciones, se enviará la señal de prueba y serás redirigido a las pantallas oficiales de conclusión del e-commerce.
                    </p>
                </div>

                <!-- LOS 3 GATILLADORES DE PRUEBA -->
                <div class="space-y-3.5">
                    
                    <button
                      type="button"
                      id="btn-simulate-success"
                      class="w-full py-4 px-6 rounded-bilbola-md bg-emerald-600 text-white font-black text-sm uppercase tracking-wide shadow-md hover:bg-emerald-700 transition-all flex items-center justify-between group"
                    >
                      <span class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center">✔</span>
                        <span>1. Simular Pago Exitoso (Transacción Aprobada)</span>
                      </span>
                      <span class="text-xs opacity-80 group-hover:translate-x-1 transition-transform">➔ /checkout/success</span>
                    </button>

                    <button
                      type="button"
                      id="btn-simulate-failure"
                      class="w-full py-4 px-6 rounded-bilbola-md bg-rose-600 text-white font-black text-sm uppercase tracking-wide shadow-md hover:bg-rose-700 transition-all flex items-center justify-between group"
                    >
                      <span class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center">✖</span>
                        <span>2. Simular Rechazo Bancario o Cancelación</span>
                      </span>
                      <span class="text-xs opacity-80 group-hover:translate-x-1 transition-transform">➔ /checkout/failure</span>
                    </button>

                    <button
                      type="button"
                      id="btn-simulate-pending"
                      class="w-full py-4 px-6 rounded-bilbola-md bg-amber-500 text-white font-black text-sm uppercase tracking-wide shadow-md hover:bg-amber-600 transition-all flex items-center justify-between group"
                    >
                      <span class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center">⏳</span>
                        <span>3. Simular Transferencia o Proceso Pendiente</span>
                      </span>
                      <span class="text-xs opacity-80 group-hover:translate-x-1 transition-transform">➔ /checkout/pending</span>
                    </button>

                </div>

                <!-- Footer del simulador -->
                <div class="pt-4 border-t border-slate-200 text-center">
                  <a 
                    href="/checkout" 
                    class="text-xs font-bold text-slate-500 hover:text-slate-800 underline transition-colors"
                  >
                    🡠 Cancelar simulación y volver al Wizard (Paso 4)
                  </a>
                </div>

            </div>
        </div>

    </div>

    <!-- SCRIPT DEL CLIENTE PARA REDIRECCIONES DE QA -->
    <script>
      function initFakeGateway() {
        const params = new URLSearchParams(window.location.search);
        const orderId = params.get('order_id') || 'BIL-998877';
        const amount = params.get('amount') || '0';
        const method = params.get('method') || 'gateway_card';

        const elOrder = document.getElementById('display-order-id');
        const elAmount = document.getElementById('display-amount');
        const elMethod = document.getElementById('display-method');

        if (elOrder) elOrder.textContent = orderId;
        if (elAmount) elAmount.textContent = `$${Number(amount).toLocaleString('es-CL')} CLP`;
        if (elMethod) elMethod.textContent = method.replace('gateway_', '').toUpperCase();

        const btnSuccess = document.getElementById('btn-simulate-success');
        const btnFailure = document.getElementById('btn-simulate-failure');
        const btnPending = document.getElementById('btn-simulate-pending');

        if (btnSuccess) {
          btnSuccess.onclick = () => {
            window.location.href = `/checkout/success?order_id=${encodeURIComponent(orderId)}&status=approved&amount=${amount}`;
          };
        }
        if (btnFailure) {
          btnFailure.onclick = () => {
            window.location.href = `/checkout/failure?order_id=${encodeURIComponent(orderId)}&status=rejected&reason=error`;
          };
        }
        if (btnPending) {
          btnPending.onclick = () => {
            window.location.href = `/checkout/pending?order_id=${encodeURIComponent(orderId)}&status=pending`;
          };
        }
      }

      initFakeGateway();
      document.addEventListener('astro:after-swap', initFakeGateway);
    </script>
</CheckoutLayout>
