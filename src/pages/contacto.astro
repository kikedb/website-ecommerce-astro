---
// src/pages/contacto.astro
import Layout from '@/layouts/Layout.astro';
import ContactHero from '@/components/ecommerce/ContactHero.astro';
import ContactInfoGrid from '@/components/ecommerce/ContactInfoGrid.astro';
import ContactForm from '@/components/ecommerce/ContactForm.vue';
import ContactFaqAccordion from '@/components/ecommerce/ContactFaqAccordion.vue';
import CtaBanner from '@/components/ecommerce/CtaBanner.astro';
---

<Layout>
  <!-- 1. Cabecera Editorial & Introducción a la Atención -->
  <ContactHero />

  <!-- 2. Sección Principal: Grid Doble con Canales y Formulario Interactivo -->
  <section id="formulario-contacto" class="py-20 bg-bilbola-surface-page font-bilbola relative">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Canales de Información (Columna Izquierda 5 cols) -->
        <div class="lg:col-span-5">
          <ContactInfoGrid />
        </div>

        <!-- Formulario Interactivo de Contacto (Columna Derecha 7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Acordeón de Preguntas Frecuentes (FAQ) -->
  <ContactFaqAccordion client:visible />

  <!-- 4. Banner de Cierre (CtaBanner) -->
  <CtaBanner
    title="¿Anhelar es el primer paso? Descubre la magia de nuestro catálogo"
    subtitle="Cada mueble y pieza textil ha sido imaginado para acompañar risas, lecturas nocturnas y los sueños de quienes más amas."
    buttonText="Explorar Colección de Productos"
    buttonUrl="/productos"
    variant="mint"
    iconName="shopping-bag"
    badge="Ternura, Magia & Calidad"
  />
</Layout>
