---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Página No Encontrada (404) | Bílbola Deco Kids" description="El rincón o mueble que buscas parece haber cambiado de lugar en la habitación de juegos. Regresa tranquilio al inicio del catálogo Bílbola.">
  <main class="min-h-[78vh] bg-gradient-to-b from-bilbola-surface-neutral/30 via-white to-bilbola-mint-light/20 flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 font-bilbola">
    
    <div class="max-w-2xl w-full text-center space-y-8 bg-white p-8 sm:p-14 rounded-bilbola-lg border border-bilbola-gray-light/60 shadow-lg relative overflow-hidden animate-fadeIn">
      
      <!-- Decoración Atmosférica Bílbola (Tokens y Grado de Luz) -->
      <div class="absolute -right-20 -top-20 w-72 h-72 bg-bilbola-support-pink/15 rounded-full blur-3xl pointer-events-none" />
      <div class="absolute -left-20 -bottom-20 w-72 h-72 bg-bilbola-mint-light/30 rounded-full blur-3xl pointer-events-none" />

      <!-- Composición Gráfica Deco Kids / Mueble Perdido -->
      <div class="relative z-10 space-y-4">
        <div class="inline-flex items-center justify-center w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-bilbola-surface-warm border-2 border-bilbola-support-pink/40 text-4xl sm:text-5xl shadow-sm mx-auto select-none">
          <span class="animate-bounce inline-block">🧭</span>
        </div>

        <div class="inline-block px-3.5 py-1.5 rounded-full bg-bilbola-surface-neutral border border-bilbola-gray-light text-bilbola-text-secondary font-black text-xs uppercase tracking-widest shadow-2xs">
          <span>Error 404 — Rincón Mágico Inexplorado</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-bilbola-text-primary tracking-tight font-bilbola-serif leading-tight">
          ¡Ups! Entramos a un rincón inexplorado en la habitación de juegos...
        </h1>
        
        <p class="text-sm sm:text-base text-bilbola-text-secondary font-medium leading-relaxed max-w-lg mx-auto">
          El castillo de madera, la biblioteca Montessori o el cofre de juegos que buscas parece haber cambiado de lugar en nuestro mapa o ya no se encuentra en la tienda.
          <br /><br />
          <span class="font-bold text-bilbola-text-primary">
            ¡Pero no te preocupes! Todo está en perfecto orden y nuestras creaciones para infancias te esperan seguras e intactas en casa.
          </span>
        </p>
      </div>

      <!-- BOTONES DE RESCATE EMPÁTICO (WCAG AA & MOBILE-FIRST 44x44px min) -->
      <div class="relative z-10 pt-4 flex flex-col sm:flex-row items-center justify-center gap-4 border-t border-bilbola-gray-light/30">
        
        <a 
          href="/" 
          class="w-full sm:w-auto px-8 py-4 bg-bilbola-action-primary hover:bg-bilbola-action-focus text-white font-black text-sm rounded-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg min-h-[48px]"
        >
          <span>🏠 Regresar al Inicio</span>
        </a>

        <a 
          href="/productos" 
          class="w-full sm:w-auto px-8 py-4 bg-bilbola-surface-neutral hover:bg-bilbola-surface-warm text-bilbola-text-primary hover:text-bilbola-action-focus font-black text-sm rounded-sm transition-all duration-200 border border-bilbola-gray-light/60 flex items-center justify-center gap-2 shadow-2xs min-h-[48px]"
        >
          <span>✨ Explorar Catálogo Deco Kids</span>
        </a>

      </div>

      <!-- Enlace secundario al soporte familiar -->
      <div class="relative z-10 pt-2 text-xs text-bilbola-text-secondary font-semibold">
        ¿Crees que se trata de un enlace defectuoso del sistema? 
        <a href="/contacto" class="text-bilbola-action-focus font-extrabold underline hover:text-bilbola-text-primary transition-colors ml-1">
          Infórmalo a nuestra Mesa de Ayuda
        </a>
      </div>

    </div>

  </main>
</Layout>
