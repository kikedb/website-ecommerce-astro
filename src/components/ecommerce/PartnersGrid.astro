---
// 8 Partners con placeholders estilizados
const partners = [
  { id: 1, name: 'Fundación Infantil de Diseño', category: 'Alianza Certificada', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=B%C3%8DLBOLA+PARTNER+1&font=montserrat' },
  { id: 2, name: 'Maderas Sustentables Chile', category: 'Materia Prima Eco', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=ECO+WOOD+2&font=montserrat' },
  { id: 3, name: 'Asociación Montessori Sur', category: 'Certificación Pedagógica', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=MONTESSORI+3&font=montserrat' },
  { id: 4, name: 'Textiles Orgánicos del Sur', category: 'Algodón 100% Natural', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=ORGANIC+TEX+4&font=montserrat' },
  { id: 5, name: 'Diseño & Infancia Magazine', category: 'Media & Prensa', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=DESIGN+KIDS+5&font=montserrat' },
  { id: 6, name: 'Arquitectos Interioristas', category: 'Colaborador Oficial', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=ARCH+DECO+6&font=montserrat' },
  { id: 7, name: 'Pinturas No-Tóxicas', category: 'Acabados Seguros', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=BIO+PAINT+7&font=montserrat' },
  { id: 8, name: 'Logística Express y Segura', category: 'Envío Garantizado', logo: 'https://placehold.co/220x80/fafcfa/1a4f4c/png?text=EXPRESS+BOX+8&font=montserrat' }
];
---

<section class="py-16 bg-white font-bilbola border-y border-bilbola-mint-light/40">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
      <span class="px-3 py-1 bg-bilbola-mint-light/50 text-bilbola-action-focus rounded-full text-xs font-extrabold tracking-widest uppercase inline-block">
        Confianza & Compromiso 🤝
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-bilbola-text-primary tracking-tight font-serif">
        Nuestros Partners y Certificaciones
      </h2>
      <p class="text-sm sm:text-base text-bilbola-text-secondary font-light">
        Trabajamos mano a mano con artesanos, proveedores sustentables y especialistas para garantizar máxima calidad y seguridad.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-6">
      {partners.map((partner) => (
        <div class="group bg-bilbola-surface-page p-5 rounded-bilbola-md border border-bilbola-mint-light/50 shadow-2xs hover:shadow-lg hover:border-bilbola-mint-depth/60 transition-all duration-300 flex flex-col items-center justify-center text-center relative overflow-hidden">
          {/* Logo Placeholder */}
          <div class="h-16 w-full flex items-center justify-center mb-3 p-2 bg-white rounded-sm border border-bilbola-gray-light/20 group-hover:scale-105 transition-transform duration-300">
            <img 
              src={partner.logo} 
              alt={partner.name}
              class="max-h-12 max-w-full object-contain filter grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-300"
              loading="lazy"
            />
          </div>

          <h4 class="font-bold text-xs text-bilbola-text-primary line-clamp-1">
            {partner.name}
          </h4>
          <span class="text-[11px] text-bilbola-text-secondary font-light mt-0.5">
            {partner.category}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
