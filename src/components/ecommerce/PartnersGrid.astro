---
import { Handshake, ShieldCheck, Leaf, Sparkles, Award, Box, Heart, CheckCircle2 } from 'lucide-vue-next';

// Alianzas y pilares de confianza oficiales del Sello Bílbola
const partners = [
  { id: 1, name: 'Calidad 100% Certificada', category: 'Sello Bílbola Deco', icon: Award, color: 'text-bilbola-action-focus', bg: 'bg-bilbola-mint-light/40' },
  { id: 2, name: 'Algodón & Fibras Nobles', category: 'Materia Prima Eco', icon: Leaf, color: 'text-green-700', bg: 'bg-green-50' },
  { id: 3, name: 'Hipoalergénicos', category: 'Nubes de Algodón', icon: ShieldCheck, color: 'text-blue-600', bg: 'bg-blue-50' },
  { id: 4, name: 'Acabados No-Tóxicos', category: 'Seguros para Bebés', icon: CheckCircle2, color: 'text-amber-600', bg: 'bg-amber-50' },
  { id: 5, name: 'Bordado Artesanal', category: 'Cero Piezas Sueltas', icon: Sparkles, color: 'text-bilbola-text-primary', bg: 'bg-[#F6DFE0]/60' },
  { id: 6, name: 'Diseño Infantil Único', category: 'Estética Sutil', icon: Heart, color: 'text-rose-600', bg: 'bg-rose-50' },
  { id: 7, name: 'Despacho Omnicanal', category: 'Falabella, Ripley & París', icon: Box, color: 'text-purple-600', bg: 'bg-purple-50' },
  { id: 8, name: 'Compromiso Familiar', category: 'Garantía de Cariño', icon: Handshake, color: 'text-teal-700', bg: 'bg-teal-50' }
];
---

<section class="py-16 bg-white font-bilbola border-y border-bilbola-mint-light/40">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-2.5 flex flex-col items-center">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-bilbola-mint-light/50 text-bilbola-action-focus rounded-full text-xs font-extrabold tracking-widest uppercase shadow-2xs">
        <Handshake class="w-3.5 h-3.5 text-bilbola-action-focus shrink-0" />
        <span>Confianza &amp; Compromiso</span>
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-bilbola-text-primary tracking-tight font-serif">
        Alianzas y Certificaciones de Calidad
      </h2>
      <p class="text-sm sm:text-base text-bilbola-text-secondary font-light">
        Trabajamos con materiales nobles y socios de confianza para garantizar la máxima seguridad y durabilidad en tu hogar.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
      {partners.map((partner) => (
        <div class="group bg-bilbola-surface-page p-6 rounded-bilbola-md border border-bilbola-mint-light/50 shadow-2xs hover:shadow-lg hover:border-bilbola-mint-depth/60 transition-all duration-300 flex flex-col items-center justify-center text-center relative overflow-hidden transform hover:-translate-y-1">
          {/* Tarjeta con Icono de Lucide en lugar de imágenes rotas */}
          <div class={`h-14 w-14 rounded-full flex items-center justify-center mb-4 ${partner.bg} border border-bilbola-gray-light/20 group-hover:scale-110 transition-transform duration-300 shadow-inner`}>
            <partner.icon class={`w-7 h-7 stroke-[2] ${partner.color}`} />
          </div>

          <h4 class="font-black text-xs text-bilbola-text-primary line-clamp-1 font-bilbola">
            {partner.name}
          </h4>
          <span class="text-[11px] text-bilbola-text-secondary font-semibold mt-1">
            {partner.category}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
