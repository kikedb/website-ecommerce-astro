---
// src/components/ecommerce/ContactHero.astro
import { Sparkles } from 'lucide-vue-next';
---

<section class="relative overflow-hidden bg-gradient-to-b from-bilbola-mint-light/40 via-bilbola-surface-neutralSoft/60 to-white pt-16 pb-20 lg:pt-24 lg:pb-28 font-bilbola selection:bg-bilbola-action-focus selection:text-white">
  <!-- Atmósfera & Mallas de Degradado (Gradient Mesh & Depth) -->
  <div class="absolute -top-20 -left-20 w-96 h-96 rounded-full bg-gradient-to-br from-bilbola-surface-warmSoft to-bilbola-mint-light/30 blur-3xl pointer-events-none opacity-80 animate-pulse duration-[8000ms]"></div>
  <div class="absolute top-1/3 -right-20 w-[28rem] h-[28rem] rounded-full bg-gradient-to-tl from-bilbola-mint-light via-[#FAF1BA]/40 to-transparent blur-3xl pointer-events-none opacity-70 animate-pulse duration-[10000ms]"></div>
  <div class="absolute bottom-6 left-1/3 w-72 h-72 rounded-full bg-bilbola-surface-warmSoft/50 blur-2xl pointer-events-none"></div>
  
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl text-center relative z-10">
    
    <!-- Badge Superior con Efecto Glassmorphism -->
    <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-bilbola-pill bg-white/90 backdrop-blur-md text-bilbola-action-focus border border-bilbola-mint-depth/40 text-xs sm:text-sm font-black tracking-widest uppercase mb-8 shadow-md transform hover:scale-105 hover:shadow-lg transition-all duration-300">
      <Sparkles class="w-4 h-4 text-bilbola-action-focus shrink-0 animate-spin duration-[6000ms]" />
      <span>Atención Personalizada Bílbola</span>
    </div>

    <!-- Titular Editorial -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-bilbola-text-primary tracking-tight leading-[1.1] mb-8 font-bilbola">
      Hablemos de magia para tu <span class="relative inline-block text-bilbola-action-focus italic transition-transform hover:scale-[1.02] duration-300">
        hogar
        <span class="absolute left-0 -bottom-2 w-full h-3 bg-bilbola-surface-warmSoft/70 -z-10 transform -rotate-1 rounded-sm"></span>
      </span>
    </h1>

    <!-- Narrativa Oficial -->
    <p class="text-base sm:text-2xl text-bilbola-text-secondary max-w-3xl mx-auto leading-relaxed font-normal mb-6 tracking-wide">
      ¿Tienes un proyecto especial para la habitación de tus hijos, buscas asesoría en medidas personalizadas o necesitas ayuda con un pedido? Nuestro equipo de interiorismo y atención está listo para acompañarte.
    </p>

  </div>
</section>
