---
// src/components/ecommerce/AboutChannelsSection.astro
import BaseButton from '@/components/ui/BaseButton.vue';
import { MapPin, Store, ShoppingBag, Truck, ExternalLink, ShoppingCart, Box, Clock } from 'lucide-vue-next';
---

<section class="py-28 bg-gradient-to-b from-bilbola-surface-neutralSoft/50 via-bilbola-mint-light/15 to-white border-t border-bilbola-mint-light/60 font-bilbola relative overflow-hidden">
  
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    
    <!-- Encabezado Editorial -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-bilbola-pill bg-bilbola-mint-depth text-white font-black text-xs tracking-widest uppercase mb-4 shadow-2xs">
        <MapPin class="w-4 h-4 text-white shrink-0" />
        <span>Presencia &amp; Disponibilidad</span>
      </span>
      <h2 class="text-4xl sm:text-5xl font-black text-bilbola-text-primary tracking-tight mb-6 font-bilbola">
        ¿Dónde Puedes Encontrarnos?
      </h2>
      <p class="text-base sm:text-xl text-bilbola-text-secondary font-medium leading-relaxed">
        Disfruta de nuestra línea de decoración exclusiva desde la comodidad de tu hogar a través de nuestros socios de confianza o visítanos en nuestro showroom físico en Vitacura.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
      
      <!-- Bloque Izquierdo: Showroom / Tienda Física Oficial (Estilo Flagship Studio) -->
      <div class="lg:col-span-5 bg-gradient-to-b from-white to-bilbola-surface-neutralSoft p-9 sm:p-12 rounded-bilbola-lg border-2 border-bilbola-mint-depth/30 shadow-xl hover:shadow-2xl transition-all duration-500 flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-40 h-40 bg-bilbola-mint-light/30 rounded-bl-[100px] pointer-events-none group-hover:scale-110 transition-transform duration-500"></div>
        
        <div>
          <div class="inline-flex p-4 rounded-bilbola-md bg-bilbola-surface-warmSoft text-bilbola-text-primary mb-8 shadow-sm group-hover:scale-105 transition-transform">
            <Store class="w-8 h-8 stroke-[2]" />
          </div>
          <span class="text-xs font-extrabold text-bilbola-action-focus uppercase tracking-widest block mb-1">Showroom Oficial</span>
          <h3 class="text-3xl font-black text-bilbola-text-primary font-bilbola mb-2 tracking-tight">
            Nuestra Tienda Física
          </h3>
          <p class="text-sm font-extrabold text-bilbola-text-secondary mb-6 uppercase tracking-wider">
            Pueblo del Inglés — Local 19
          </p>
          
          <div class="space-y-4 text-base text-bilbola-text-secondary font-normal leading-relaxed">
            <p>
              Estamos felices de recibirte en nuestro espacio, diseñado para que explores en persona la suavidad de nuestros textiles, maderas nobles y te sumerjas en la magia visual que hemos creado.
            </p>
            <div class="p-5 rounded-bilbola-md bg-white border-l-4 border-bilbola-action-focus shadow-xs mt-6">
              <p class="font-black text-bilbola-text-primary text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <MapPin class="w-3.5 h-3.5 text-bilbola-action-focus" />
                Dirección Comercial
              </p>
              <p class="text-sm font-semibold text-bilbola-text-secondary leading-snug">
                Avenida Vitacura 6195, Local 19,<br/>
                Pueblo del Inglés, Vitacura, Santiago.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-bilbola-gray-light/30">
          <BaseButton 
            href="https://maps.google.com/?q=Pueblo+del+Ingles+Vitacura+Local+19" 
            variant="primary" 
            size="lg"
            class="w-full font-black text-white shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-3 py-4"
          >
            <MapPin class="w-5 h-5 shrink-0" />
            <span>Ver mapa de ubicación</span>
            <ExternalLink class="w-4 h-4 shrink-0 opacity-80" />
          </BaseButton>
        </div>
      </div>

      <!-- Bloque Derecho: Canales Digitales y Apps de Despacho Rápido -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-8">
        
        <!-- Canales Retail Online (Grandes Tiendas y Tiendas de Diseño) -->
        <div class="bg-white p-8 sm:p-11 rounded-bilbola-lg border border-bilbola-gray-light/40 shadow-md hover:shadow-xl transition-all duration-500 flex-grow relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-bilbola-mint-light/20 rounded-bl-full pointer-events-none"></div>
          
          <div class="flex items-center gap-4 mb-6">
            <span class="p-3 rounded-bilbola-md bg-bilbola-mint-light/50 text-bilbola-action-focus shadow-xs">
              <ShoppingBag class="w-7 h-7 stroke-[2]" />
            </span>
            <div>
              <h4 class="text-2xl font-black text-bilbola-text-primary font-bilbola">Tiendas en Línea &amp; Retail</h4>
              <p class="text-xs text-bilbola-text-secondary font-bold uppercase tracking-wide">Encuentra nuestro catálogo oficial 24/7</p>
            </div>
          </div>
          
          <p class="text-sm sm:text-base text-bilbola-text-secondary font-normal leading-relaxed mb-8">
            Además de nuestra tienda online oficial <strong class="text-bilbola-text-primary font-bold">Bilbola.cl</strong>, estamos presentes y validados en los marketplaces de e-commerce y curatorías de diseño más prestigiosas del país:
          </p>
          
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="py-4 px-3 rounded-bilbola-md bg-bilbola-surface-neutralSoft/80 hover:bg-bilbola-mint-light/40 font-extrabold text-bilbola-text-primary text-center text-sm shadow-2xs border border-bilbola-gray-light/20 transform hover:-translate-y-1 transition-all duration-300 cursor-default">
              Falabella
            </div>
            <div class="py-4 px-3 rounded-bilbola-md bg-bilbola-surface-neutralSoft/80 hover:bg-bilbola-mint-light/40 font-extrabold text-bilbola-text-primary text-center text-sm shadow-2xs border border-bilbola-gray-light/20 transform hover:-translate-y-1 transition-all duration-300 cursor-default">
              Ripley
            </div>
            <div class="py-4 px-3 rounded-bilbola-md bg-bilbola-surface-neutralSoft/80 hover:bg-bilbola-mint-light/40 font-extrabold text-bilbola-text-primary text-center text-sm shadow-2xs border border-bilbola-gray-light/20 transform hover:-translate-y-1 transition-all duration-300 cursor-default">
              París
            </div>
            <div class="py-4 px-3 rounded-bilbola-md bg-bilbola-surface-neutralSoft/80 hover:bg-bilbola-mint-light/40 font-extrabold text-bilbola-text-primary text-center text-sm shadow-2xs border border-bilbola-gray-light/20 transform hover:-translate-y-1 transition-all duration-300 cursor-default">
              ED Diseño
            </div>
          </div>
        </div>

        <!-- Apps de Entrega a Domicilio Rápida -->
        <div class="bg-gradient-to-r from-white via-white to-[#FAF1BA]/25 p-8 sm:p-11 rounded-bilbola-lg border border-bilbola-gray-light/40 shadow-md hover:shadow-xl transition-all duration-500 relative overflow-hidden">
          <div class="flex items-center gap-4 mb-6">
            <span class="p-3 rounded-bilbola-md bg-[#FAF1BA] text-bilbola-text-primary shadow-xs">
              <Truck class="w-7 h-7 stroke-[2]" />
            </span>
            <div>
              <h4 class="text-2xl font-black text-bilbola-text-primary font-bilbola">Despacho Exprés por Apps</h4>
              <p class="text-xs text-bilbola-text-secondary font-bold uppercase tracking-wide">Entrega directa en la puerta de tu hogar</p>
            </div>
          </div>

          <p class="text-sm sm:text-base text-bilbola-text-secondary font-normal leading-relaxed mb-8">
            Si necesitas tu regalo de cumpleaños o pieza decorativa hoy mismo, contamos con servicios de despacho inmediato a través de tus aplicaciones de delivery de confianza:
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <span class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-bilbola-text-primary font-extrabold text-xs sm:text-sm tracking-wide shadow-sm border border-bilbola-gray-light/40 hover:border-bilbola-action-focus hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 cursor-default">
              <ShoppingCart class="w-4 h-4 text-bilbola-action-focus shrink-0" />
              <span>Cornershop</span>
            </span>
            <span class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-bilbola-text-primary font-extrabold text-xs sm:text-sm tracking-wide shadow-sm border border-bilbola-gray-light/40 hover:border-bilbola-action-focus hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 cursor-default">
              <Clock class="w-4 h-4 text-bilbola-action-focus shrink-0" />
              <span>Rappi</span>
            </span>
            <span class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-bilbola-text-primary font-extrabold text-xs sm:text-sm tracking-wide shadow-sm border border-bilbola-gray-light/40 hover:border-bilbola-action-focus hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 cursor-default">
              <Box class="w-4 h-4 text-bilbola-action-focus shrink-0" />
              <span>Pedidos Ya</span>
            </span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
