---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
    title?: string;
}

const { title = "Checkout Seguro | Bílbola" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content="Finaliza tu compra de forma segura en Bílbola. Conexión encriptada SSL 256 bits y garantía mágica." />
    <title>{title}</title>
    <ClientRouter />
</head>
<body class="bg-bilbola-surface-page text-bilbola-text-primary min-h-screen flex flex-col font-bilbola selection:bg-bilbola-mint-light selection:text-bilbola-text-primary">

    <!-- CABECERA LIMPIA (Without promotional banners or distracting navigation per brandbook) -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-bilbola-gray-light/30 shadow-xs">
        <div class="mx-auto px-4 sm:px-6 max-w-6xl py-4 flex items-center justify-between min-h-[72px]">
            
            <!-- IZQUIERDA: Enlace de retorno seguro al catálogo -->
            <a 
              href="/productos" 
              class="inline-flex items-center gap-2 text-xs font-bold text-bilbola-text-secondary hover:text-bilbola-action-focus transition-colors focus:outline-none focus:ring-2 focus:ring-bilbola-action-focus p-2 rounded-bilbola-sm"
              title="Volver a la tienda"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="hidden sm:inline">Volver a la tienda</span>
            </a>

            <!-- CENTRO: Logo Oficial de Bílbola -->
            <div class="flex items-center justify-center">
                <a href="/" class="hover:opacity-95 transition-opacity px-2" title="Bílbola - Inicio">
                    <img src="/logo-bilbola.png" alt="Logo Bílbola" class="h-10 sm:h-12 w-auto object-contain" />
                </a>
            </div>

            <!-- DERECHA: Sello de Seguridad SSL -->
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-bilbola-mint-light/20 border border-bilbola-mint-depth/40 text-bilbola-action-focus shadow-2xs">
                <svg class="w-4 h-4 shrink-0 text-bilbola-action-focus" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-[11px] sm:text-xs font-bold tracking-wide">Checkout 100% Seguro</span>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL DEL CHECKOUT -->
    <main class="flex-grow max-w-6xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-10">
        <slot />
    </main>

    <!-- FOOTER TRANSACTIONS -->
    <footer class="bg-bilbola-surface-neutral border-t border-bilbola-gray-light/30 text-bilbola-text-secondary py-8 mt-12">
        <div class="max-w-4xl mx-auto text-center px-4 space-y-4">
            <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold text-bilbola-text-primary">
              <span class="inline-flex items-center gap-1.5">
                <span class="text-bilbola-action-focus">✔</span> Garantía Mágica de 30 días
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="text-bilbola-action-focus">✔</span> Despachos a todo Chile
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="text-bilbola-action-focus">✔</span> Conexión Bancaria Encriptada (Flow)
              </span>
            </div>
            
            <div class="border-t border-bilbola-gray-light/20 pt-4">
              <p class="text-[11px] leading-relaxed text-bilbola-text-secondary/80 max-w-lg mx-auto">
                Tus datos de pago son manejados confidencialmente bajo estándares SSL y cumplimiento bancario de nivel militar por Flow y Transbank. Bílbola nunca almacena los números de tus tarjetas bancarias.
              </p>
              <p class="text-[11px] font-bold mt-2 text-bilbola-text-primary/70">
                Bílbola Deco Kids &copy; {new Date().getFullYear()} — Un mundo de sueños
              </p>
            </div>
        </div>
    </footer>
</body>
</html>
