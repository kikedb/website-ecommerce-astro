---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bilbola Deco Kids</title>
</head>
<body class="bg-brand-secondary text-brand-primary min-h-screen flex flex-col font-serif">
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 p-4 border-b border-brand-gray/20">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-black text-brand-accent tracking-widest">
                Bílbola <span class="font-light text-brand-primary">deco kids</span>
            </a>
            <nav class="hidden md:flex space-x-6 text-brand-primary font-semibold">
                <a href="/" class="hover:text-brand-accent transition-colors">Inicio</a>
                <a href="/productos" class="hover:text-brand-accent transition-colors">Productos</a>
                <a href="/nosotros" class="hover:text-brand-accent transition-colors">Nosotros</a>
            </nav>
        </div>
    </header>

    <main class="flex-grow">
        <slot />
    </main>

    <footer class="bg-brand-primary text-brand-secondary py-12 mt-12">
        <div class="container mx-auto text-center px-4">
            <p class="text-lg">Un mundo de sueños</p>
            <p class="text-sm mt-4 text-brand-secondary/80">Bilbola Deco Kids &copy; {new Date().getFullYear()}</p>
        </div>
    </footer>
</body>
</html>
